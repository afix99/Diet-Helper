  { "slug": "study", "category": "MIND & DESK", "name": "Studying — reading and writing", "met": 1.8, "notes": "Around 50 kcal an hour above rest. Real, and much less than it feels. The tiredness after revision is mental fatigue, not empty fuel." },
  { "slug": "exam", "category": "MIND & DESK", "name": "Sitting an exam", "met": 1.8, "notes": "Same cost as revising. Stress raises your pulse without raising the bill much. Mental fatigue is not the same as running out of fuel." },
  { "slug": "lecture", "category": "MIND & DESK", "name": "In a lecture or class", "met": 1.8, "notes": "Sitting and taking notes. Mental effort is cheap in calories — mental fatigue is not the same as running out of fuel." },
  { "slug": "reading", "category": "MIND & DESK", "name": "Reading, sitting", "met": 1.3, "notes": "About 20 kcal an hour above rest. Thinking hard barely moves this — mental fatigue is not hunger." },
  { "slug": "desk-work", "category": "MIND & DESK", "name": "Desk work", "met": 1.5, "notes": "About 30 kcal an hour above rest — mostly the shifting and typing, not the thinking. Mental fatigue is not the same as running out of fuel." },
  { "slug": "coding", "category": "MIND & DESK", "name": "Coding at a computer", "met": 1.5, "notes": "Same as any desk work. Concentration does not add a measurable amount — mental fatigue is not hunger." },
  { "slug": "meeting", "category": "MIND & DESK", "name": "In a meeting", "met": 1.5, "notes": "Seated, light effort. Draining is not the same as expensive: mental fatigue is not a fuel shortage." },
  { "slug": "sitting-quietly", "category": "MIND & DESK", "name": "Sitting quietly", "met": 1.3, "notes": "Almost exactly rest. Logged here so you can see what thinking actually adds on top — mental fatigue is not hunger." },
  { "slug": "standing-work", "category": "MIND & DESK", "name": "Standing desk work", "met": 2.0, "notes": "Standing costs a little more than sitting. Mental fatigue is not the same as running out of fuel." },
